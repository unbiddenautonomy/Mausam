{
  "name": "@mausam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "release": "(wrangler d1 migrations apply mausam --remote || true) && wrangler deploy && wrangler d1 migrations apply mausam --remote",
    "db:migrate:local": "wrangler d1 migrations apply mausam --local",
    "db:migrate:remote": "wrangler d1 migrations apply mausam --remote",
    "typecheck": "tsc -p .",
    "db:seed:demo": "node scripts/demo-seed.mjs > .wrangler/demo.sql && wrangler d1 execute mausam --local --file .wrangler/demo.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mausam/shared": "workspace:*",
    "hono": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "http_ece": "^1.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.40.0"
  }
}
