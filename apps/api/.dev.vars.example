# Local development secrets. Copy to apps/api/.dev.vars (which git ignores) and fill in what you need.
# In production these are Worker secrets: `npx wrangler secret put NAME`. Never commit real values.

# Phone reminders: the private half of `node scripts/vapid-keys.mjs`. Put the public half in wrangler.jsonc.
VAPID_PRIVATE_KEY=

# Memo reading (optional): an API key from console.anthropic.com.
ANTHROPIC_API_KEY=

# If set, creating the first owner account asks for this code. Leave empty locally.
SETUP_CODE=
