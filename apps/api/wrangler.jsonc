{
  // Cloudflare Worker for the Mausam admin app and its API. See docs/cloudflare-setup.md before deploying.
  "name": "mausam-admin",
  "main": "src/index.ts",
  // The same Worker serves the admin app's built files and the /api routes, so it's one deploy and one web address.
  // `pnpm build` at the repo root makes ../admin/dist; Cloudflare's build step runs it for you.
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mausam",
      // No id needed: the first deploy creates the "mausam" database, and later deploys find it by name.
      "migrations_dir": "migrations"
    }
  ],
  // Photos and nightly backups, in Workers KV (free, no card needed). No id needed: the first deploy creates it.
  "kv_namespaces": [{ "binding": "FILES" }],
  // Every 15 minutes: check what's overdue and raise alerts. The same run takes the nightly backup (after 4 am IST).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Slow down PIN guessing and runaway clients. These need no setup: Cloudflare creates them on deploy.
  // namespace_id is just a number unique within your account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Live logs in the dashboard under mausam-admin → Observability
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // Leave empty: the app and API share one address. Only list other sites (comma-separated) if they must call the API.
    "ALLOWED_ORIGIN": "",
    // How many nightly database backups to keep (backups/YYYY-MM-DD.json in the FILES storage).
    "BACKUP_DAYS": "35",
    // How long bill and memo photos are kept. 400 days keeps the free 1 GB of storage from filling up.
    "PHOTO_DAYS": "400",
    // Phone reminders need no setup: the Worker makes its own keys on first use and keeps them in the database.
    // Model used to read handwritten memos. The API key is a secret named ANTHROPIC_API_KEY,
    // added in the Cloudflare dashboard (see docs/cloudflare-setup.md).
    "MEMO_MODEL": "claude-opus-5-5"
  }
  // Secrets (never in this file). Add them in the Cloudflare dashboard (Settings → Variables and secrets):
  //   ANTHROPIC_API_KEY   memo reading (optional)
  //   SETUP_CODE          required to create the first owner account (recommended)
}
