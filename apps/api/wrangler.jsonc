{
  // Cloudflare Worker for the Mausam admin app and its API. See docs/cloudflare-setup.md before deploying.
  "name": "mausam-admin",
  "main": "src/index.ts",
  // The same Worker serves the admin app's built files and the /api routes, so it's one deploy and one web address.
  // `pnpm build` at the repo root makes ../admin/dist; Cloudflare's build step runs it for you.
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mausam",
      // No id needed: the first deploy creates the "mausam" database, and later deploys find it by name.
      "migrations_dir": "migrations"
    }
  ],
  // Created on the first deploy if it doesn't exist yet.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "mausam-photos" }],
  // Live logs in the dashboard under mausam-admin → Observability
  "observability": { "enabled": true },
  // Every 15 minutes: check what's overdue and raise alerts
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "*",
    // Phone reminders need no setup: the Worker makes its own keys on first use and keeps them in the database.
    // Model used to read handwritten memos. The API key is a secret named ANTHROPIC_API_KEY,
    // added in the Cloudflare dashboard (see docs/cloudflare-setup.md).
    "MEMO_MODEL": "claude-opus-5-5"
  }
}
