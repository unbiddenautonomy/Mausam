{
  "name": "mausam",
  "private": true,
  "scripts": {
    "setup:local": "pnpm build && pnpm --filter @mausam/api db:migrate:local",
    "dev:api": "pnpm --filter @mausam/api dev",
    "dev:admin": "pnpm --filter @mausam/admin dev",
    "build": "pnpm --filter @mausam/admin build",
    "ship": "pnpm build && pnpm --filter @mausam/api run deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
